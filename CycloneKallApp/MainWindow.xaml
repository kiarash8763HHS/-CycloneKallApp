<Window x:Class="CycloneKallApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Cyclone Kall App" Height="720" Width="900" MinHeight="650" MinWidth="760"
        WindowStartupLocation="CenterScreen" Background="#080B14"
        FlowDirection="RightToLeft" FontFamily="Segoe UI">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#E8ECF7"/></Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="#111522"/><Setter Property="Background" Value="#171D30"/>
            <Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="0,7,0,0"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Foreground" Value="White"/><Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Padding" Value="14,9"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="Slider"><Setter Property="Margin" Value="0,8,0,0"/></Style>
    </Window.Resources>

    <Grid Margin="28">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,22">
            <TextBlock Text="CYCLONE KALL APP" FontSize="31" FontWeight="ExtraBold" Foreground="#5EF2DC"/>
            <TextBlock Text="Cyclone Kall App • استودیوی حرفه‌ای تقویت و پردازش میکروفون"
                       FontSize="13" Foreground="#8994B2" Margin="0,4,0,0"/>
            <Border Height="2" Margin="0,15,0,0">
                <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                    <GradientStop Color="#5EF2DC" Offset="0"/><GradientStop Color="#8A5CFF" Offset="1"/>
                </LinearGradientBrush></Border.Background>
            </Border>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
          <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="1.25*"/><ColumnDefinition Width="1*"/></Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#101626" CornerRadius="14" Padding="20" Margin="0,0,10,0" BorderBrush="#202B47" BorderThickness="1">
              <StackPanel>
                <TextBlock Text="CYCLONE KALL APP • ورودی" FontSize="17" FontWeight="Bold" Foreground="#5EF2DC"/>
                <TextBlock Text="اول میکروفونت را انتخاب کن؛ لیست مستقیماً از دستگاه‌های فعال ویندوز خوانده می‌شود."
                           FontSize="11" Foreground="#8490AD" TextWrapping="Wrap" Margin="0,5,0,10"/>
                <TextBlock Text="میکروفون" FontWeight="SemiBold"/>
                <ComboBox x:Name="MicComboBox" SelectionChanged="MicComboBox_SelectionChanged"/>

                <TextBlock Text="بوست صدا" FontWeight="SemiBold" Margin="0,22,0,0"/>
                <TextBlock x:Name="BoostText" Text="+18.0 dB" FontSize="28" FontWeight="ExtraBold" Foreground="#5EF2DC"/>
                <Slider x:Name="BoostSlider" Minimum="0" Maximum="100" Value="18" TickFrequency="1"
                        IsSnapToTickEnabled="True" ValueChanged="BoostSlider_ValueChanged"/>
                <Grid Margin="0,1,0,0"><TextBlock Text="0 dB" FontSize="10" Foreground="#707C9B" HorizontalAlignment="Left"/>
                    <TextBlock Text="+100 dB" FontSize="10" Foreground="#707C9B" HorizontalAlignment="Right"/></Grid>
                <TextBlock Text="بوست ۱ تا ۱۰۰ دسی‌بل قابل انتخاب است؛ برای جلوگیری از کلیپ، خروجی با لیمیتر کنترل می‌شود."
                           FontSize="10" Foreground="#7E89A5" TextWrapping="Wrap" Margin="0,5,0,0"/>

                <TextBlock Text="پروفایل سریع" FontWeight="SemiBold" Margin="0,22,0,7"/>
                <WrapPanel>
                    <Button Content="دعوا / VOICE" Click="FightPreset_Click" Background="#5C3BFF" Margin="0,0,7,7"/>
                    <Button Content="واضح / CLEAR" Click="ClearPreset_Click" Background="#1C7F76" Margin="0,0,7,7"/>
                    <Button Content="استودیو" Click="StudioPreset_Click" Background="#26324F" Margin="0,0,7,7"/>
                    <Button Content="خاموش" Click="FlatPreset_Click" Background="#26324F" Margin="0,0,7,7"/>
                </WrapPanel>
              </StackPanel>
            </Border>

            <Border Grid.Column="1" Background="#101626" CornerRadius="14" Padding="20" Margin="10,0,0,0" BorderBrush="#202B47" BorderThickness="1">
              <StackPanel>
                <TextBlock Text="CYCLONE KALL APP • پردازش" FontSize="17" FontWeight="Bold" Foreground="#A98BFF"/>
                <TextBlock Text="کنترل‌های ساده به‌جای ساخت کانفیگ دستی؛ تغییرات هنگام اجرا اعمال می‌شوند."
                           FontSize="11" Foreground="#8490AD" TextWrapping="Wrap" Margin="0,5,0,16"/>

                <TextBlock Text="Noise Gate / حذف صدای خیلی ضعیف" FontWeight="SemiBold"/>
                <Slider x:Name="GateSlider" Minimum="0" Maximum="0.12" Value="0.015" ValueChanged="Processing_ValueChanged"/>
                <TextBlock x:Name="GateText" Text="15" FontSize="11" Foreground="#7E89A5"/>

                <TextBlock Text="Compression / فشرده‌سازی صدا" FontWeight="SemiBold" Margin="0,18,0,0"/>
                <Slider x:Name="CompSlider" Minimum="0" Maximum="1" Value="0.72" ValueChanged="Processing_ValueChanged"/>
                <TextBlock x:Name="CompText" Text="72%" FontSize="11" Foreground="#7E89A5"/>

                <TextBlock Text="Presence / وضوح صدای گفتار" FontWeight="SemiBold" Margin="0,18,0,0"/>
                <Slider x:Name="PresenceSlider" Minimum="0" Maximum="12" Value="3" ValueChanged="Processing_ValueChanged"/>
                <TextBlock x:Name="PresenceText" Text="+3 dB" FontSize="11" Foreground="#7E89A5"/>

                <TextBlock Text="خروجی" FontWeight="SemiBold" Margin="0,20,0,0"/>
                <ComboBox x:Name="OutputComboBox"/>
                <TextBlock Text="برای Discord / FiveM / بازی، یک Virtual Cable مثل VB-CABLE را به‌عنوان خروجی انتخاب کن و CABLE Output را در برنامه مقصد به‌عنوان Mic بگذار."
                           FontSize="10" Foreground="#7E89A5" TextWrapping="Wrap" Margin="0,6,0,0"/>

                <Button x:Name="StartStopButton" Content="▶ شروع پردازش Cyclone Kall App" Click="StartStopButton_Click"
                        Height="50" Margin="0,22,0,0">
                    <Button.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#5EF2DC" Offset="0"/><GradientStop Color="#805BFF" Offset="1"/>
                    </LinearGradientBrush></Button.Background>
                </Button>
                <Button Content="↻ بروزرسانی میکروفون‌ها" Click="RefreshButton_Click" Background="#1C2740" Height="38" Margin="0,9,0,0"/>
              </StackPanel>
            </Border>
          </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#101626" CornerRadius="10" Padding="12" Margin="0,18,0,0" BorderBrush="#202B47" BorderThickness="1">
            <TextBlock x:Name="StatusText" Text="CYCLONE KALL APP • آماده — یک میکروفون انتخاب کن." Foreground="#B8C1D9" TextWrapping="Wrap"/>
        </Border>
    </Grid>
</Window>